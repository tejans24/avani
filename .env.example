# --- Database ---
DATABASE_URL=postgresql://avani:avani@localhost:5432/avani

# --- Clerk auth (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated emails allowed into the platform (single-tenant guard on top of Clerk)
ALLOWED_EMAILS=you@yourcompany.com

# --- Email (https://resend.com) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="Avani <invoices@yourdomain.com>"
# resend | fake  (fake writes emails to .fake-emails/ instead of sending)
EMAIL_MODE=resend

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# test bypasses Clerk entirely — ONLY for local e2e runs, never production
AUTH_MODE=clerk

# --- Mercury bank sync (https://mercury.com -> Settings -> API tokens; READ-ONLY token) ---
MERCURY_API_KEY=secret-token:mercury_xxx
# live | fake  (fake reads JSON fixtures from e2e/fixtures/mercury/)
MERCURY_MODE=live

# --- SMS (break-glass notifications only; Twilio) ---
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15555550100
OWNER_PHONE=+15555550123
# twilio | fake  (fake writes .fake-sms/)
SMS_MODE=twilio

# --- Event tick (Vercel cron hits /api/events/tick every 15 min) ---
# Set CRON_SECRET in Vercel (auto-sent as Authorization: Bearer) and/or use ?secret=TICK_SECRET
TICK_SECRET=change-me

# Optional: external dead-man ping (https://healthchecks.io) hit on every tick
HEALTHCHECK_PING_URL=
